!/config/*.example.yaml
!/config/*.docker.yaml
!/config/*test.yaml

# Volumes
/logs

/client/node_modules
/client/dist
/client/.env

/storage/*
!storage/mailer-templates
!storage/migrations

coverage.html
coverage.out

/build/wealthwarden
/build/wealthwarden.exe